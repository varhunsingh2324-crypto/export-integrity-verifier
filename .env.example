# Copy to .env (git-ignored). The DSNs match the local Docker dev database in docker-compose.yml.
PG_DSN=postgresql://eguard:eguard@localhost:5432/eguard
SCRATCH_DSN=postgresql://eguard:eguard@localhost:5432/eguard?options=-csearch_path%3Dscratch
# Placeholder: replace with a secret of your own, e.g. the output of `openssl rand -hex 32`.
MANIFEST_HMAC_KEY=change-me
