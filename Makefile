# ExportGuard developer commands. See README.md.
-include .env
export

VENV   := .venv
PY     := $(VENV)/bin/python
STAMP  := $(VENV)/.installed

.PHONY: up down test lint doctor seed incident faults verify-all explain bench dashboard demo clean-data disk

# Everything here is regenerated by make incident / faults / bench (rule 10).
# A new generated data/ subdirectory must be added to this list.
DATA_GENERATED := data/exports data/reports data/bench data/manifests data/dev

$(STAMP): pyproject.toml
	python3 -m venv $(VENV)
	$(PY) -m pip install -q --upgrade pip
	$(PY) -m pip install -q -e '.[dev]'
	touch $(STAMP)

up:
	docker compose up -d --wait

down:
	docker compose down

test: $(STAMP)
	$(PY) -m pytest -q

lint: $(STAMP)
	$(VENV)/bin/ruff check .
	$(VENV)/bin/ruff format --check .

doctor: $(STAMP)
	$(VENV)/bin/eguard doctor

seed: $(STAMP)
	$(PY) -m sim.incident seed

incident: $(STAMP)
	$(PY) -m sim.incident run

faults: $(STAMP)                # F0-F7 + F1h from a 50k-row incident (DB: make up; MANIFEST_HMAC_KEY)
	$(PY) -m sim.faults

clean-data:                     # delete regenerable data (rebuild: make incident faults)
	rm -rf $(DATA_GENERATED)

disk:                           # disk budget check: ~1.5 GB for the whole project
	@for d in .venv data; do du -sh $$d 2>/dev/null || echo "-	$$d (absent)"; done
	@du -sh . | sed 's|\.$$|project total|'  # separate call: du counts a directory only once
	@docker system df

bench: $(STAMP)                 # L1 streaming memory/throughput so far (full bench: phase 8)
	$(PY) bench/l1_memory.py

# Matrix of every export: fault x (gzip -t, L1-L5, verdict). eguard exits with the worst verdict
# (rule 7); one JSON + HTML report per export lands in data/reports. make itself fails only on a
# tool error (3), since the fault gallery is CORRUPT by design.
verify-all: $(STAMP)
	$(VENV)/bin/eguard verify-all data/exports --out data/reports/verify_all.json \
		--report-dir data/reports || [ $$? -le 2 ]

# Size forensics for the two acceptance pairs (phase 7): the incident (v1 -> v2) and F7 (same
# table, pigz -6 -> gzip -1). Reuses the verify reports from `make verify-all` if they are current.
explain: $(STAMP)
	$(VENV)/bin/eguard explain data/exports/v1.sql.gz data/exports/v2.sql.gz --report-dir data/reports
	$(VENV)/bin/eguard explain data/exports/fault_source/v2_hardened.sql.gz \
		data/exports/F7_gzip1.sql.gz --report-dir data/reports

# Stubs: fail loudly until their phase lands, so a stub never looks like success.
dashboard demo:
	@echo "make $@: not implemented yet (phase 8)" >&2; exit 1
