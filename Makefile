# ExportGuard developer commands. See README.md.
-include .env
export

VENV   := .venv
PY     := $(VENV)/bin/python
STAMP  := $(VENV)/.installed

.PHONY: up down test lint doctor seed incident faults verify-all bench dashboard demo clean-data disk

# Everything here is regenerated by make incident / faults / bench (rule 10).
# A new generated data/ subdirectory must be added to this list.
DATA_GENERATED := data/exports data/reports data/bench data/manifests data/dev

$(STAMP): pyproject.toml
	python3 -m venv $(VENV)
	$(PY) -m pip install -q --upgrade pip
	$(PY) -m pip install -q -e '.[dev]'
	touch $(STAMP)

up:
	docker compose up -d --wait

down:
	docker compose down

test: $(STAMP)
	$(PY) -m pytest -q

lint: $(STAMP)
	$(VENV)/bin/ruff check .
	$(VENV)/bin/ruff format --check .

doctor: $(STAMP)
	$(VENV)/bin/eguard doctor

seed: $(STAMP)
	$(PY) -m sim.incident seed

incident: $(STAMP)
	$(PY) -m sim.incident run

faults: $(STAMP)                # F1-F6 + signed source manifest (DB: make up; MANIFEST_HMAC_KEY); F7 later
	$(PY) -m sim.faults

clean-data:                     # delete regenerable data (rebuild: make incident faults)
	rm -rf $(DATA_GENERATED)

disk:                           # disk budget check: ~1.5 GB for the whole project
	@for d in .venv data; do du -sh $$d 2>/dev/null || echo "-	$$d (absent)"; done
	@du -sh . | sed 's|\.$$|project total|'  # separate call: du counts a directory only once
	@docker system df

bench: $(STAMP)                 # L1 streaming memory/throughput so far (full bench: phase 8)
	$(PY) bench/l1_memory.py

# Stubs: fail loudly until their phase lands, so a stub never looks like success.
verify-all:
	@echo "make $@: not implemented yet (phase 6)" >&2; exit 1
dashboard demo:
	@echo "make $@: not implemented yet (phase 8)" >&2; exit 1
