<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ExportGuard report</title>
<style>
{% include "_style.css.j2" %}

</style>
</head>
<body>
<main>
<h1>ExportGuard verification report</h1>
<div class="muted path">{{ r.path }}</div>

<section class="banner {{ r.verdict }}" aria-label="verdict">
  <span class="verdict">{{ r.verdict }}</span>
  <span class="ral">RAL {{ r.ral }}/5</span>
  <span>exit code {{ r.exit_code }}</span>
  <span>
  {% for lr in r.layers %}<span class="st {{ lr.status }}" title="{{ lr.name }}">L{{ lr.layer }} {{ lr.status }}</span> {% endfor %}
  </span>
</section>

<section class="summary" aria-label="summary">
{% for sentence in summary %}
  <p>{{ sentence }}</p>
{% endfor %}
</section>

{% if r.reasons %}
<h2>{{ "What failed" if r.verdict == "CORRUPT" else "Missing evidence" }}</h2>
<ul>
{% for reason in r.reasons %}
  <li>{{ reason }}</li>
{% endfor %}
</ul>
{% endif %}

<h2>Where in the stream</h2>
{% if locations %}
<div class="wrap"><table>
  <tr><th>Layer</th><th>Check</th><th>Location</th><th>Finding</th></tr>
  {% for loc, place in locations %}
  <tr><td>L{{ loc.layer }}</td><td>{{ loc.check }}</td><td>{{ place }}</td><td>{{ loc.detail }}</td></tr>
  {% endfor %}
</table></div>
{% if locations_more %}<p class="muted">… and {{ locations_more }} more location(s) in the JSON report.</p>{% endif %}
{% else %}
<p class="muted">No check located a problem in the stream.</p>
{% endif %}

<h2>Layers and evidence</h2>
<div class="wrap"><table>
  <tr><th>Check</th><th>Status</th><th>Severity</th><th>Result and evidence</th></tr>
  {% for lr, checks in layers %}
  <tr class="layer"><td colspan="2">L{{ lr.layer }} {{ lr.name }}</td>
    <td><span class="st {{ lr.status }}">{{ lr.status }}</span></td>
    <td>{{ lr.reason if lr.status != "PASS" else lr.checks ~ " check(s), all PASS (counts toward RAL)" }}</td></tr>
    {% for c in checks %}
  <tr><td>{{ c.name }}</td><td><span class="st {{ c.status }}">{{ c.status }}</span></td>
    <td>{{ c.severity }}</td>
    <td>{{ c.message }}
      {% if c.evidence %}<details><summary>evidence</summary><pre>{{ evidence(c.evidence) }}</pre></details>{% endif %}
    </td></tr>
    {% endfor %}
  {% endfor %}
</table></div>

<h2>Restore drill confidence (L5)</h2>
<div class="confidence">
{% for statement in confidence %}
  <p>{{ statement }}</p>
{% endfor %}
{% if r.verdict != "VERIFIED" %}
  <p class="muted">The drill only covers rows that are in this file. It does not outweigh the {{ "failures" if r.verdict == "CORRUPT" else "missing evidence" }} listed above.</p>
{% endif %}
</div>

<h2>Provenance</h2>
<dl>
  <dt>Compressor (from bytes)</dt><dd>{{ prov.compressor or "not recorded" }}{% if prov.level_hint %} · level hint: {{ prov.level_hint }}{% endif %}</dd>
  <dt>Compressor (manifest)</dt><dd>{{ prov.manifest_compressor or "not recorded" }}</dd>
  {% if gzip_t is not none %}<dt>gzip -t</dt><dd>{{ "OK (exit 0)" if gzip_t == 0 else "FAIL (exit " ~ gzip_t ~ ")" }}</dd>{% endif %}
  <dt>pg_dump</dt><dd>{{ prov.pg_dump or "not recorded" }}</dd>
  <dt>Source database</dt><dd>{{ prov.dumped_from or "not recorded" }}</dd>
  <dt>Snapshot</dt><dd>{% if prov.snapshot_id %}{{ prov.snapshot_id }} (repeatable read, taken {{ prov.snapshot_taken_at }}){% else %}not recorded{% endif %}</dd>
  <dt>Manifest</dt><dd>{{ prov.manifest_status }}{% if prov.manifest %}<br><span class="path muted">{{ prov.manifest }}</span>{% endif %}{% if prov.manifest_created_at %}<br><span class="muted">created {{ prov.manifest_created_at }}</span>{% endif %}</dd>
  <dt>L5 sample seed</dt><dd>{{ prov.l5_seed if prov.l5_seed is not none else "not recorded" }}</dd>
  <dt>Verified by</dt><dd>{{ prov.tool }}{% if r.generated_at %} at {{ r.generated_at }}{% endif %}</dd>
</dl>

<footer class="muted">Exit codes: 0 VERIFIED · 1 SUSPECT · 2 CORRUPT · 3 tool error. RAL = number of layers (0–5) whose checks all passed with full evidence. The JSON report next to this file holds the same checks and evidence.</footer>
</main>
</body>
</html>
